# The first rule is the default target: ``snakemake --cores 1`` runs the whole workflow.
# You can run ``snakemake -call all`` to call the "all" rule.

rule all:
    input: "results/figure.png"

rule get_data:
    output:
        "data/costs_2035.csv",
        "data/tyndp2026-nt2035-hourly-demand-wind-solar.csv",
        "data/tyndp2026-nt2035-wind-solar-capacity.csv"
    script: "scripts/get_data_1.py"

rule get_costs:
    input: "data/costs_2035.csv"
    output: "data/costs.csv"
    script: "scripts/get_costs_2.py"

rule get_timeseries:
    input: "data/tyndp2026-nt2035-hourly-demand-wind-solar.csv"
    output: "data/timeseries.csv"
    script: "scripts/get_timeseries_3.py"

rule build_model:
    input:
        ts=rules.get_timeseries.output,
        costs=rules.get_costs.output,
        p_nom_max="data/tyndp2026-nt2035-wind-solar-capacity.csv"
    output: "results/cem.nc"
    script: "scripts/build_model_4.py"

rule solve:
    input: rules.build_model.output
    output: "results/solved_cem.nc"
    script: "scripts/solve_5.py"

rule plot:
    input: rules.solve.output
    output: "results/figure.png"
    script: "scripts/plot_6.py"
